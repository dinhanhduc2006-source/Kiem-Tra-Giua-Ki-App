<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="36dp"
    android:paddingBottom="16dp">

    <!-- Tiêu đề Màn hình & Nút Quay lại -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/gray_text"
            android:text="← Quay lại"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btnBack"
            android:text="PHIẾU MƯỢN ĐANG HIỆU LỰC"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Danh sách các phiếu mượn chưa trả -->
    <ListView
        android:id="@+id/lvBorrowTickets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Thông báo nếu không có phiếu mượn -->
    <TextView
        android:id="@+id/tvEmptyTickets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Hiện không có phiếu mượn nào đang còn hiệu lực."
        android:textColor="@color/gray_text"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
